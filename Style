:root {
  --yellow: #facc15;
  --yellow-dark: #dca400;
  --dark: #0f172a;
  --dark-2: #1e293b;
  --grey: #f1f5f9;
  --text: #0f172a;
  --muted: #64748b;
  --white: #ffffff;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: Arial, Helvetica, sans-serif; color: var(--text); background: var(--white); line-height: 1.6; }
a { text-decoration: none; color: inherit; }
.container { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
.top-bar { background: #020617; color: #cbd5e1; font-size: 14px; }
.top-bar-content { display: flex; flex-wrap: wrap; gap: 18px; justify-content: space-between; padding: 10px 0; }
.main-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); border-bottom: 1px solid #e2e8f0; backdrop-filter: blur(10px); }
.nav-content { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 15px 0; }
.brand { display: flex; align-items: center; gap: 12px; }
.brand-icon { width: 48px; height: 48px; border-radius: 50%; background: var(--yellow); display: grid; place-items: center; font-weight: 900; font-size: 24px; color: var(--dark); box-shadow: 0 8px 18px rgba(250,204,21,.35); }
.brand h1 { font-size: 20px; line-height: 1.1; }
.brand p { font-size: 12px; color: var(--muted); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
nav { display: flex; gap: 26px; font-weight: 700; font-size: 14px; color: #334155; }
nav a:hover { color: var(--yellow-dark); }
.quote-btn, .primary-btn, .secondary-btn, .quote-form button { display: inline-block; border-radius: 999px; font-weight: 900; transition: .2s ease; }
.quote-btn { background: var(--yellow); color: var(--dark); padding: 12px 22px; }
.quote-btn:hover, .primary-btn:hover, .quote-form button:hover { background: #fde047; transform: translateY(-1px); }
.hero { position: relative; overflow: hidden; background: var(--dark); color: var(--white); }
.hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(15,23,42,.96), rgba(15,23,42,.86) 45%, rgba(250,204,21,.18)); }
.hero-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; padding: 82px 0; }
.tag { display: inline-block; background: var(--yellow); color: var(--dark); border-radius: 999px; padding: 10px 18px; font-size: 13px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 22px; }
.hero h2 { font-size: clamp(42px, 6vw, 72px); line-height: 1.05; font-weight: 900; }
.hero p { max-width: 620px; color: #cbd5e1; font-size: 18px; margin-top: 24px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
.primary-btn { background: var(--yellow); color: var(--dark); padding: 15px 28px; }
.secondary-btn { border: 1px solid rgba(255,255,255,.35); color: var(--white); padding: 14px 28px; background: rgba(255,255,255,.08); }
.secondary-btn:hover { background: rgba(255,255,255,.16); }
.hero-image-card { position: relative; min-height: 430px; border-radius: 34px; padding: 18px; background: linear-gradient(135deg, #fde047, #f59e0b, #0f172a); box-shadow: 0 30px 80px rgba(0,0,0,.36); overflow: hidden; }
.hero-image-card img { position: absolute; bottom: 0; left: 50%; width: 108%; max-height: 440px; transform: translateX(-50%); object-fit: contain; filter: drop-shadow(0 24px 26px rgba(0,0,0,.45)); }
.call-card { position: absolute; left: 26px; bottom: 26px; background: rgba(15,23,42,.88); color: var(--white); padding: 18px 22px; border-radius: 20px; backdrop-filter: blur(8px); }
.call-card span { display: block; color: #cbd5e1; font-size: 14px; }
.call-card strong { display: block; color: var(--yellow); font-size: 24px; margin-top: 4px; }
.stats { background: var(--yellow); padding: 28px 0; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; text-align: center; }
.stats-grid div { background: rgba(255,255,255,.45); border-radius: 18px; padding: 18px; }
.stats strong { display: block; font-size: 32px; font-weight: 900; color: var(--dark); }
.stats span { display: block; color: #334155; font-weight: 800; text-transform: uppercase; font-size: 13px; letter-spacing: 1px; }
.section-padding { padding: 78px 0; }
.grey-bg { background: var(--grey); }
.dark-bg { background: var(--dark); color: var(--white); }
.section-label { display: block; color: var(--yellow-dark); font-weight: 900; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 12px; }
.section-title { text-align: center; margin-bottom: 42px; }
.section-title h2, .about h2, .contact h2 { font-size: clamp(32px, 4vw, 46px); line-height: 1.16; font-weight: 900; }
.left-title { display: flex; align-items: end; justify-content: space-between; gap: 28px; text-align: left; }
.left-title p { max-width: 520px; color: var(--muted); }
.about-grid, .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.about p, .contact p { color: var(--muted); margin-top: 18px; }
.check-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 28px; }
.check-grid span { font-weight: 700; color: #334155; }
.check-grid span::before { content: "✓"; color: var(--yellow-dark); font-weight: 900; margin-right: 10px; }
.about-card { background: var(--dark); color: var(--white); border-radius: 30px; padding: 36px; box-shadow: 0 18px 40px rgba(15,23,42,.2); }
.about-card h3 { font-size: 32px; line-height: 1.15; }
.about-card p { color: #cbd5e1; }
.card-grid { display: grid; gap: 24px; }
.three { grid-template-columns: repeat(3, 1fr); }
.four { grid-template-columns: repeat(4, 1fr); }
.service-card, .fleet-card, .feature-card { border-radius: 28px; padding: 30px; background: var(--white); box-shadow: 0 16px 35px rgba(15,23,42,.08); }
.service-card .icon { width: 55px; height: 55px; border-radius: 18px; background: var(--yellow); display: grid; place-items: center; font-weight: 900; margin-bottom: 18px; }
.service-card h3, .fleet-card h3, .feature-card h3 { font-size: 23px; margin-bottom: 12px; }
.service-card p, .fleet-card p { color: var(--muted); }
.fleet-grid { grid-template-columns: repeat(3, 1fr); }
.fleet-card { padding: 0 0 28px; overflow: hidden; }
.fleet-card div { height: 120px; background: linear-gradient(135deg, #fde047, #f59e0b, #1e293b); margin-bottom: 24px; }
.fleet-card h3, .fleet-card p { padding: 0 24px; }
.feature-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); box-shadow: none; }
.feature-card p { color: #cbd5e1; }
.contact-list { list-style: none; margin-top: 28px; display: grid; gap: 12px; font-size: 17px; color: #334155; }
.management-card { margin-top: 30px; background: #fefce8; border: 1px solid #fde68a; border-radius: 26px; padding: 26px; }
.management-card h3 { margin-bottom: 12px; }
.management-card p { margin-top: 8px; color: #334155; }
.management-card hr { border: none; border-top: 1px solid #fde68a; margin: 14px 0; }
.quote-form { background: var(--grey); border-radius: 30px; padding: 32px; box-shadow: 0 18px 40px rgba(15,23,42,.12); display: grid; gap: 16px; }
.quote-form input, .quote-form select, .quote-form textarea { width: 100%; border: 1px solid #cbd5e1; border-radius: 17px; padding: 14px 16px; font-size: 15px; outline: none; font-family: inherit; }
.quote-form textarea { min-height: 140px; resize: vertical; }
.quote-form input:focus, .quote-form select:focus, .quote-form textarea:focus { border-color: var(--yellow-dark); box-shadow: 0 0 0 3px rgba(250,204,21,.22); }
.quote-form button { border: 0; cursor: pointer; background: var(--yellow); color: var(--dark); padding: 16px 26px; font-size: 16px; }
.footer { background: #020617; color: #94a3b8; text-align: center; padding: 36px 0; }
.footer h3 { color: var(--white); font-size: 22px; margin-bottom: 8px; }
.footer p { margin-top: 8px; }
@media (max-width: 980px) {
  nav { display: none; }
  .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
  .stats-grid, .four { grid-template-columns: repeat(2, 1fr); }
  .three, .fleet-grid { grid-template-columns: 1fr; }
  .hero-image-card { min-height: 360px; }
  .left-title { display: block; }
  .left-title p { margin-top: 14px; }
}
@media (max-width: 640px) {
  .nav-content { align-items: flex-start; flex-direction: column; }
  .quote-btn { width: 100%; text-align: center; }
  .hero-grid { padding: 58px 0; }
  .hero-actions a { width: 100%; text-align: center; }
  .stats-grid, .check-grid, .four { grid-template-columns: 1fr; }
  .call-card { left: 16px; right: 16px; bottom: 16px; }
  .call-card strong { font-size: 20px; }
}
